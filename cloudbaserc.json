{
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "version": "2.0",
  "envId": "{{替换为你的 CloudBase 环境 ID}}",
  "framework": {
    "name": "xm-tech-portal",
    "plugins": {
      "node": {
        "use": "@cloudbase/framework-plugin-node",
        "inputs": {
          "name": "xm-tech-portal",
          "path": "/",
          "entry": "scf_bootstrap",
          "platform": "nodejs18",
          "buildCommand": "npm run build:cloudbase",
          "installCommand": "npm install",
          "functionTimeout": 60,
          "memorySize": 512,
          "envVariables": {}
        }
      }
    }
  }
}
