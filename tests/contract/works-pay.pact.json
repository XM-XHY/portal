      "requestShape": { "plan": "string", "client": "string", "reqId": "string(optional,idempotency)" },
      "response": {
        "status": 200,
        "bodyShape": {
          "orderId": "string",
          "codeUrl": "string",
          "expiresAt": "string",
          "amount": "number",
          "plan": "string",
          "days": "number",
          "planName": "string"
        },
        "idempotentBodyShape": {
          "orderId": "string",
          "codeUrl": "string|null",
          "expiresAt": "string",
          "amount": "number",
          "plan": "string",
          "days": "number",
          "planName": "string",
          "idempotent": "boolean(true)"
        }
      }
    },
    {
      "id": "work-member-claim",
      "providerState": "订单已支付(paid)且绑定购买账号",
      "endpoint": { "method": "POST", "path": "/api/works/pay/claim" },
      "requestShape": { "orderId": "string" },
      "response": {
        "status": 200,
        "bodyShape": { "paid": "boolean(true)", "plan": "string", "days": "number", "planName": "string" }
      },
      "errorResponses": [
        { "status": 401, "when": "未登录", "bodyShape": { "error": "string" } },
        { "status": 404, "when": "订单不存在", "bodyShape": { "error": "string" } },
        { "status": 400, "when": "订单未支付 / 非会员订单", "bodyShape": { "error": "string" } },
        { "status": 403, "when": "SEC-04 跨账号领取被拒(o.work.userId !== uid)", "bodyShape": { "error": "string" } }
      ]
    },
    {
      "id": "work-member-status",
      "providerState": "按订单号查询会员状态",
      "endpoint": { "method": "GET", "path": "/api/works/pay/status?id={orderId}" },
      "response": {
        "status": 200,
        "bodyShape": {
          "paid": "boolean",
          "orderPaid": "boolean",
          "granted": "boolean",
          "plan": "string|null",
          "days": "number|null",
          "planName": "string",
          "expiresAt": "string",
          "amount": "number",
          "status": "string"
        }
