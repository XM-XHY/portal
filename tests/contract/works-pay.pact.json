      "methods": {
        "createNativePayment(order, notifyBase)": {
          "returns": { "codeUrl": "string" }
        },
        "verifyCallback(rawBody, headers)": {
          "returns": { "outTradeNo": "string", "tradeNo": "string", "paid": "boolean", "amountFen": "number" }
        }
      }
    },
    "Order": {
      "source": "lib/orders.ts",
      "requiredFields": ["id", "productId", "productTitle", "amount", "amountFen", "provider", "status", "createdAt", "expiresAt"]
    }
  },
  "interactions": [
