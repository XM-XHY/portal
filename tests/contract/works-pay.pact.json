        "bodyShape": { "code_url": "string" }
      }
    },
    {
      "id": "payment-callback-verify",
      "providerState": "支付网关异步回调验签解密后",
      "description": "verifyCallback 返回的字段是 mock-notify、/api/pay/callback/* 等回调处理方唯一可依赖的形状（SEC-05 依赖 outTradeNo + amountFen 做一致性校验）。",
      "response": {
        "returns": { "outTradeNo": "string", "tradeNo": "string", "paid": "boolean", "amountFen": "number" }
      }
    },
    {
      "id": "work-member-create",
      "providerState": "已登录作品账号 + 套餐存在 + 支付通道可用",
