# ============================================================
# XX 科技门户 — 环境变量示例
# 用法：复制本文件为 .env，按需填入；不要提交真实 .env 到仓库。
# ============================================================

# ===== 生产必填密钥（缺任意一项，生产环境将 fail-fast 拒绝启动）=====
# 生成：openssl rand -hex 32  （或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
# ⚠️ 这里不再提供可直接使用的默认值：源码中的开发兜底值仅用于本地开发，
#    一旦 NODE_ENV=production 且缺以下任一变量，服务会主动抛错退出，而不是静默使用弱密钥。

# 后台会话签名密钥（必填）
ADMIN_SESSION_SECRET=

# 密码哈希盐值（必填）。与 JSON / Supabase / CloudBase PG 存储共用。
# ⚠️ 换成新盐后，库中已有 pw_hash 全部失效，后台会登不进。
#    必须配套执行一次口令重算：node scripts/rotate-admin-password.mjs --apply
ADMIN_PASSWORD_SALT=

# 付费下载授权票据的签名密钥（必填）。未配置时回落 ADMIN_SESSION_SECRET（可用，但建议独立）。
# 更换后，此前签发的下载票据立即失效，用户需重新获取。
PAY_GRANT_SECRET=

# 作品中心会员会话密钥（必填）。未配置时回落 ADMIN_SESSION_SECRET（可用，但建议独立）。
# 更换后，作品中心已登录用户需重新登录。
WORK_SESSION_SECRET=

# ⚠️ 首次播种的初始管理员口令（仅当 admins 表为空时生效）。
# 源码里不再硬编码任何明文口令：配置本变量即用其值；未配置则随机生成并打印一次到启动日志。
# 已有账号（线上库里已存在）不受影响，但历史口令仍建议在「后台 → 账号安全」手动轮换一次。
# 生成强口令：openssl rand -base64 24
INITIAL_ADMIN_PASSWORD=

# 微信公众号（分班查询）消息接口：
# WECHAT_MP_TOKEN=           服务器配置里的 Token
# WECHAT_MP_APPID=           公众号 AppID
# WECHAT_MP_APPSECRET=       公众号 AppSecret（设置菜单/素材时用）
# WECHAT_MP_AESKEY=          消息加解密密钥（43 位，选「安全模式」时必填；明文/兼容模式可不填）
# WECHAT_MP_DEFAULT_CODE=    可选：默认查询码，家长只发姓名也能查

# ============================================================
# 数据存储（二选一，应用自动检测）
# ============================================================
# 方案 A：Supabase（推荐用于生产 / Serverless，如 Vercel 部署）
# 配置 SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY 后，应用自动切换到 Supabase，
# 无需改动任何代码。表结构见 supabase/schema.sql（在 Supabase SQL Editor 执行）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 可选：用于前端的匿名 Key（当前实现未使用，预留）
SUPABASE_ANON_KEY=

# 方案 B：本地 JSON 文件（默认，零依赖）
# 不配置上面的 SUPABASE_* 时，数据写入 data/db.json。
# 无需额外变量。

# ============================================================
# 获客模块 — 全网检索
# ============================================================
# ⚠️ 重要变更：微软已于 2025-08-11 全面退役 Bing Search API v7，
# 新用户无法注册，旧密钥返回 410 Gone。请勿再使用 BING_API_KEY。
#
# 优先级：Brave → Tavily → SerpAPI → Bing（历史兼容）→ 内置示例数据
# 全部未配置时，/api/search 返回内置示例数据，保证无密钥也能演示。

# 【推荐 1】Brave Search API：独立索引，结构化结果，合规风险低
# 价格：约 $5 / 1000 次，每月赠送 $5 额度（≈1000 次/月免费）
# 申请：https://brave.com/search/api/  → 复制 API Key
BRAVE_API_KEY=

# 【推荐 2】Tavily：面向 AI 应用设计，单次返回 results + 自带 answer 摘要
# 价格：约 $0.008 / 次，注册赠送额度
# 申请：https://app.tavily.com/
TAVILY_API_KEY=

# 可选：SerpAPI（Google / Bing 结果页），起步 $25/月（含 1000 次），有 250 次/月免费
SERPAPI_KEY=

# 可选：强制指定供应商（brave | tavily | serpapi | bing）；留空则按上面优先级自动选择
# SEARCH_PROVIDER=brave

# 已退役，仅作历史兼容保留（不建议配置）
# BING_API_KEY=

# 搜索结果市场/语言，默认中文
SEARCH_MKT=zh-CN

# ============================================================
# 获客模块 — LLM 摘要与引用（可选）
# 配置后，真实检索结果会由大模型生成"带引用来源的摘要"（RAG）。
# 走 OpenAI 兼容接口，可替换为 DeepSeek / 通义 / 自建网关（改 LLM_BASE_URL 即可）。
# 不配置则只展示原始检索结果，不做摘要。
# ============================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============================================================
# 教师工作台订阅管理 — 服务端代理（网站后台 → 云函数 ent）
# ============================================================
# 仅服务端使用，绝不暴露到浏览器；任一项缺失时后台订阅管理接口会明确报错，不会静默降级。
# 云函数 ent 网关根地址（需包含 /ent 前缀，且不要以 / 结尾）。
# 例：https://<env>-<appid>.ap-shanghai.app.tcloudbase.com/ent
TWB_ENT_API_BASE=

# 管理共享密钥：随每个管理请求以 X-Ent-Admin 头发送给云函数 ent。
# 必须与云函数 ent 侧配置完全一致；请生成随机强值，仅保存在部署平台环境变量中。
TWB_ENT_ADMIN_SECRET=
