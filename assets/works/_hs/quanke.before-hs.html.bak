 {"基础": {"q": "郡县制始于___", "a": "秦", "h": "—"}, "变式": {"q": "行省制始于___朝", "a": "元", "h": "—"}, "拔高": {"q": "君主立宪在英国确立标志___", "a": "《权利法案》", "h": "—"}}, "专题·历史·国际关系": {"基础": {"q": "冷战开始的标志___", "a": "杜鲁门主义", "h": "—"}, "变式": {"q": "两极格局指美苏___", "a": "对峙", "h": "—"}, "拔高": {"q": "欧盟前身___", "a": "欧共体", "h": "—"}}},"vmx":{}}}},"道法":{"errs":["概念混淆", "材料分析", "价值辨析", "其他"],"versions":{"人教版(统编)":{"bank":{"成长的节拍": {"基础": {"q": "中学时代是人生发展的___时期", "a": "重要(新起点)", "h": "—"}, "变式": {"q": "学习___(不仅)局限在学校", "a": "不仅仅", "h": "—"}, "拔高": {"q": "正确认识自己途径：___、他人评价", "a": "自我评价", "h": "—"}}, "友谊与师长": {"基础": {"q": "友谊是一种___关系", "a": "亲密", "h": "—"}, "变式": {"q": "网上交友要增强___意识(慎重)", "a": "安全/自我保护", "h": "—"}, "拔高": {"q": "师生彼此尊重关键是___", "a": "尊重差异与人格", "h": "—"}}, "生命与价值": {"基础": {"q": "生命是___的、不可逆的", "a": "独特(宝贵)", "h": "—"}, "变式": {"q": "敬畏生命要___对待他人生命", "a": "平等(不漠视)", "h": "—"}, "拔高": {"q": "生命价值在于___(创造/贡献)", "a": "为社会作贡献", "h": "—"}}, "青春与情绪": {"基础": {"q": "情绪基本类型：喜、怒、哀、___", "a": "惧", "h": "—"}, "变式": {"q": "调节情绪方法：转移注意、___等", "a": "合理宣泄(或倾诉)", "h": "—"}, "拔高": {"q": "青春期矛盾心理表现：___与依赖等", "a": "独立(反抗)", "h": "—"}}, "集体生活": {"基础": {"q": "集体力量来源于成员___", "a": "共同目标与团结", "h": "—"}, "变式": {"q": "个人利益与集体利益___(一致/冲突)", "a": "在根本上一致", "h": "—"}, "拔高": {"q": "美好集体是___、公正的", "a": "民主", "h": "—"}}, "宪法": {"基础": {"q": "我国根本法、治国安邦总章程是___", "a": "宪法", "h": "—"}, "变式": {"q": "宪法规定国家生活中的___问题", "a": "根本(全局性)", "h": "—"}, "拔高": {"q": "宪法日是每年___月___日", "a": "12月4日", "h": "—"}}, "公民权利义务": {"基础": {"q": "___既是权利也是义务(例：受教育)", "a": "劳动/受教育", "h": "—"}, "变式": {"q": "权利与义务是___的", "a": "统一(一致)", "h": "—"}, "拔高": {"q": "依法行使权利不得损害___利益", "a": "国家、社会、集体和他人", "h": "—"}}, "法治精神": {"基础": {"q": "法律的特征：由国家制定或认可、___保证实施、普遍约束力", "a": "国家强制力", "h": "—"}, "变式": {"q": "违法行为分民事、行政、___", "a": "刑事", "h": "—"}, "拔高": {"q": "犯罪最本质特征___", "a": "严重社会危害性", "h": "—"}}, "改革开放与共同富裕": {"基础": {"q": "___是强国之路", "a": "改革开放", "h": "—"}, "变式": {"q": "共同富裕不是___富裕", "a": "同步(同等)", "h": "—"}, "拔高": {"q": "发展的根本目的是___", "a": "增进民生福祉", "h": "—"}}, "生态文明": {"基础": {"q": "我国坚持___文明建设(绿色)", "a": "生态", "h": "—"}, "变式": {"q": "绿水青山就是___", "a": "金山银山", "h": "—"}, "拔高": {"q": "节约资源基本国策要求___(循环利用)", "a": "节约优先", "h": "—"}}, "国家安全与国家利益": {"基础": {"q": "___是安邦定国的重要基石", "a": "国家安全", "h": "—"}, "变式": {"q": "国家利益___(高于/等于)个人利益", "a": "高于", "h": "—"}, "拔高": {"q": "总体国家安全观以___安全为宗旨", "a": "人民", "h": "—"}}, "中国梦": {"基础": {"q": "中国梦指___复兴", "a": "中华民族", "h": "—"}, "变式": {"q": "实现中国梦必须走___道路", "a": "中国", "h": "—"}, "拔高": {"q": "两个一百年：建党百年___，建国百年建成现代化强国", "a": "全面建成小康社会", "h": "—"}}, "专题·道法·辨析题": {"基础": {"q": "辨析题第一步先___(判断对错)", "a": "判断", "h": "—"}, "变式": {"q": "辨析须结合___说明理由", "a": "教材知识点", "h": "—"}, "拔高": {"q": "辨析结尾应___(总结提升)", "a": "总结观点", "h": "—"}}, "专题·道法·概念区分": {"基础": {"q": "'权利'与'权力'：法定利益用___", "a": "权利", "h": "—"}, "变式": {"q": "'法治'强调依法治国，'法制'指___", "a": "法律制度", "h": "—"}, "拔高": {"q": "'法制'与'法治'区别在是否___", "a": "治国方式(动态)", "h": "—"}}, "专题·道法·材料分析": {"基础": {"q": "分析题先___材料主旨", "a": "审读", "h": "—"}, "变式": {"q": "答题要___知识点+材料", "a": "结合", "h": "—"}, "拔高": {"q": "开放性试题须___(价值观正确)", "a": "符合题意、正向", "h": "—"}}, "专题·道法·实践探究": {"基础": {"q": "活动设计要___(可行)", "a": "可操作", "h": "—"}, "变式": {"q": "调查可采用问卷、___等", "a": "访谈", "h": "—"}, "拔高": {"q": "成果展示可用手抄报、___", "a": "PPT/报告", "h": "—"}}, "专题·道法·国情述评": {"基础": {"q": "我国基本国情是处于___阶段", "a": "社会主义初级", "h": "—"}, "变式": {"q": "我国社会主要矛盾已转化为___需要与发展不平衡", "a": "美好生活", "h": "—"}, "拔高": {"q": "新阶段理念：创新、协调、绿色、开放、___", "a": "共享", "h": "—"}}},"vmx":{}}}}};
let curSubj = "数学";
let curVer = Object.keys(SUBJECTS[curSubj].versions)[0];
let BANK = SUBJECTS[curSubj].versions[curVer].bank;
let VMATRIX = SUBJECTS[curSubj].versions[curVer].vmx;
let GSEL = "全部";
// ---- 学科 / 版本切换 ----
function buildSubjBar(){ const bar=document.getElementById("subjbar"); bar.innerHTML=""; Object.keys(SUBJECTS).forEach(s=>{ const b=document.createElement("button"); b.textContent=s; b.className="subjbtn"+(s===curSubj?" on":""); b.onclick=()=>switchSubj(s); bar.appendChild(b); }); }
function switchSubj(s){ if(s===curSubj) return; curSubj=s; curVer=Object.keys(SUBJECTS[s].versions)[0]; applySubj(); switchTab("录入错题"); }
function switchVer(v){ if(v===curVer) return; curVer=v; applyVer(); }
function applySubj(){ BANK=SUBJECTS[curSubj].versions[curVer].bank; VMATRIX=SUBJECTS[curSubj].versions[curVer].vmx; STORE_KEY=curStore(); mistakes=load(); GSEL="全部"; rebuildVerSel(); rebuildGradeSel(); rebuildKpSelects(); rebuildErrSel(); renderAll(); updateHeaders(); buildSubjBar(); }
function applyVer(){ BANK=SUBJECTS[curSubj].versions[curVer].bank; VMATRIX=SUBJECTS[curSubj].versions[curVer].vmx; GSEL="全部"; rebuildGradeSel(); rebuildKpSelects(); renderAll(); updateHeaders(); rebuildVerSel(); }
function rebuildVerSel(){ const v=document.getElementById("vSel"); v.innerHTML=""; Object.keys(SUBJECTS[curSubj].versions).forEach(x=>v.appendChild(new Option(x,x))); v.value=curVer; }
function rebuildErrSel(){ const e=document.getElementById("mErr"); e.innerHTML=""; (SUBJECTS[curSubj].errs||["其他"]).forEach(x=>e.appendChild(new Option(x,x))); }
function updateHeaders(){ const e=document.getElementById("vbarSubj"); if(e) e.textContent=curSubj; }
function switchTab(t){ const b=document.querySelector('.tabs button[data-t="'+t+'"]'); if(b) b.click(); }

// ===================== 通用逻辑 =====================
let STORE_KEY = curStore();
function curStore(){ return "super9_"+curSubj+"_v1"; }
let mistakes = load();
function load(){ try { return JSON.parse(localStorage.getItem(STORE_KEY)) || []; } catch(e){ return []; } }
function save(){
  try{ localStorage.setItem(STORE_KEY, JSON.stringify(mistakes)); }catch(e){}
  // 阶段 B：错题库按学科同步到主站数据库，本地仅作缓存
  try{ if(window.QKCloud) window.QKCloud.syncMistakes(curSubj, mistakes); }catch(e2){}
}
function today(){ return new Date().toISOString().slice(0,10); }
function gradeOf(kp){ if(VMATRIX[kp]) return VMATRIX[kp]; if(kp.indexOf("小学")===0) return "小学"; if(kp.indexOf("初中")===0) return "初中"; if(kp.indexOf("专题")===0) return "专题"; return "中考"; }
function allGrades(){ const s=new Set(); const ks=Object.keys(VMATRIX); if(ks.length){ Object.values(VMATRIX).forEach(g=>s.add(g)); } else { s.add("小学"); s.add("初中"); s.add("专题"); s.add("中考"); } const ord=["全部","三上","三下","四上","四下","五上","五下","六上","六下","七上","七下","八上","八下","九上","九下","小学","初中","专题","中考"]; const arr=Array.from(s).sort((x,y)=>ord.indexOf(x)-ord.indexOf(y)); return ["全部"].concat(arr); }
function rebuildKpSelects(){
  const a=document.getElementById("mKp"), b=document.getElementById("chKp"), c=document.getElementById("drillKp");
  [a,b,c].forEach(s=>s.innerHTML="");
  Object.keys(BANK).forEach(kp=>{ if(GSEL!=="全部" && gradeOf(kp)!==GSEL) return; a.appendChild(new Option(kp,kp)); b.appendChild(new Option(kp,kp)); c.appendChild(new Option(kp,kp)); });
}
function rebuildGradeSel(){ const g=document.getElementById("gSel"); g.innerHTML=""; allGrades().forEach(x=>g.appendChild(new Option(x,x))); g.value="全部"; }

function renderAll(){ renderMistakes(); renderWeak(); }

// ① 录入
function addMistake(){
  const text=document.getElementById("mText").value.trim();
  const kp=document.getElementById("mKp").value, level=document.getElementById("mLevel").value, err=document.getElementById("mErr").value;
  if(!text){ alert("请先填错题原文"); return; }
  mistakes.push({id:"ERR-"+Date.now(), text, kp, level, err, date:today(), mastered:false});
  save(); renderAll(); document.getElementById("mText").value="";
  alert("已存入错题库 ✅");
}
function loadDemo(){
  const ks=Object.keys(BANK); if(!ks.length){ alert("当前科目暂无题库"); return; }
  const errs=SUBJECTS[curSubj].errs||["其他"];
  const lv=["C","B","A","B","C","B"];
  ks.slice(0,6).forEach((kp,i)=>{ mistakes.push({id:"ERR-"+Date.now()+Math.random().toString(16).slice(2,6), text:kp+" 练习中出错", kp, level:lv[i%lv.length], err:errs[i%errs.length], date:today(), mastered:false}); });
  save(); renderAll(); alert("已载入示例错题 ✅（"+curSubj+"）");
}
// ② 错题库
function renderMistakes(){
  const tb=document.querySelector("#mistakeTbl tbody"); tb.innerHTML="";
  if(!mistakes.length){ tb.innerHTML='<tr><td colspan="5" class="mut">暂无</td></tr>'; return; }
  mistakes.slice().reverse().forEach(m=>{
    const tr=document.createElement("tr");
    tr.innerHTML=`<td>${m.date}</td><td>${m.kp}</td><td>${m.level}</td><td><span class="tag">${m.err}</span></td>`+
      `<td>${m.mastered?'<span class="ok">已掌握</span>':'<button class="ghost" onclick="markMaster(\''+m.id+'\')">再测通过</button>'}</td>`;
    tb.appendChild(tr);
  });
}
function markMaster(id){ const x=mistakes.find(z=>z.id===id); if(x){ x.mastered=true; save(); renderAll(); } }
function exportJSON(){ if(!mistakes.length){alert("暂无数据");return;} const data={version:"2.0",updated_at:new Date().toISOString(),records:mistakes}; download(new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),"错题库.json"); }
function exportCSV(){ if(!mistakes.length){alert("暂无数据");return;} const head="id,date,kp,level,err,mastered\n"; const body=mistakes.map(m=>[m.id,m.date,m.kp,m.level,m.err,m.mastered].join(",")).join("\n"); download(new Blob([head+body],{type:"text/csv;charset=utf-8"}),"错题库.csv"); }
function download(blob,name){ const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=name; a.click(); URL.revokeObjectURL(a.href); }
function clearAll(){ if(!confirm("确定清空错题库？此操作会同步删除云端保存的记录。")) return; mistakes=[]; save(); renderAll(); }
// ③ 薄弱Top3
function computeWeak(){ const c={}; mistakes.forEach(m=>c[m.kp]=(c[m.kp]||0)+1); return Object.entries(c).sort((a,b)=>b[1]-a[1]).slice(0,3); }
function renderWeak(){
  const box=document.getElementById("weakBox"); const arr=computeWeak();
  if(!arr.length){ box.innerHTML='<p class="mut">还没有数据，先录入或载入示例错题。</p>'; return; }
  const max=arr[0][1];
  box.innerHTML=arr.map(([kp,c])=>`<div style="margin:8px 0;"><b>${kp}</b> <span class="mut">(${c} 次)</span><div class="bar"><i style="width:${Math.round(c/max*100)}%"></i></div></div>`).join("")+'<p class="mut">点「⑦真题特训 → 针对最薄弱」一键出三题。</p>';
}
// ④ 分层出题
function lvlMap(l){ return l==="A"?"拔高":l==="B"?"变式":"基础"; }
function genChuti(){
  const kp=document.getElementById("chKp").value, lv=document.getElementById("chLevel").value, out=document.getElementById("chOut");
  const set=BANK[kp]; const real=lvlMap(lv); const it=set[real];
  out.innerHTML=`<div class="drill"><h3>${kp} · ${lv}档（${real}题）</h3><div class="q"><b>[${real}]</b> ${it.q}<br><span class="ok">答案：${it.a}</span><br><span class="mut">解析：${it.h}</span></div></div>`;
}
function genChutiAll(){
  const kp=document.getElementById("chKp").value, out=document.getElementById("chOut"); const set=BANK[kp];
  out.innerHTML=`<div class="drill"><h3>${kp} · 三档全出</h3>`+["基础","变式","拔高"].map(l=>`<div class="q"><b>[${l}]</b> ${set[l].q}<br><span class="ok">答案：${set[l].a}</span><br><span class="mut">解析：${set[l].h}</span></div>`).join("")+`</div>`;
}
// ⑤ 作业批改
function pigai(){
  const raw=document.getElementById("pgInput").value.trim(); const out=document.getElementById("pgOut");
  if(!raw){ alert("请先输入题目"); return; }
  const rows=raw.split("\n").map(s=>s.trim()).filter(Boolean);
  let html='<table><thead><tr><th>题</th><th>学生答案</th><th>标准答案</th><th>结果</th><th>错因</th></tr></thead><tbody>';
  let score=0;
  rows.forEach((r,i)=>{
    const p=r.split("|").map(x=>x.trim()); if(p.length<3){ return; }
    const ok=p[1]===p[2]; if(ok) score++;
    html+=`<tr><td>${i+1}</td><td>${p[1]}</td><td>${p[2]}</td><td>${ok?'<span class="ok">✅</span>':'<span class="tag">❌</span>'}</td><td>${ok?'—':'计算错误'}</td></tr>`;
  });
  html+=`</tbody></table><p>正确率：${score}/${rows.length}（${Math.round(score/rows.length*100)}%）</p>`;
  out.innerHTML=html;
}
function loadPgDemo(){ document.getElementById("pgInput").value="求 (-3)+7 | 3 | 4\n解 2x+3=11 | x=3 | x=4\n√16 | 8 | 4\n化简 x/x² | x | 1/x"; pigai(); }
// ⑥ 学情周报
function genZhoubao(){
  const out=document.getElementById("zbOut");
  if(!mistakes.length){ out.innerHTML='<p class="mut">错题库为空，先录入错题。</p>'; return; }
  const c={}; mistakes.forEach(m=>c[m.kp]=(c[m.kp]||0)+1);
  const sorted=Object.entries(c).sort((a,b)=>b[1]-a[1]);
  const top3=sorted.slice(0,3);
  const mastered=mistakes.filter(m=>m.mastered).length;
  let html=`<div class="drill"><h3>学情周报（基于当前错题库）</h3>`;
  html+=`<p>录入错题 <b>${mistakes.length}</b> 条 · 涉及知识点 <b>${sorted.length}</b> 个 · 已掌握 <b>${mastered}</b> 条</p>`;
  html+=`<p><b>全班/个人最弱 Top3：</b></p><ol>`+top3.map(([kp,n])=>`<li>${kp}（${n}次）</li>`).join("")+`</ol>`;
  html+=`<p class="mut">教学建议：下周优先专练「${top3[0][0]}」，配基础+变式+拔高三题闭环。</p>`;
  html+=`<table><thead><tr><th>知识点</th><th>错次</th><th>占比</th></tr></thead><tbody>`+sorted.map(([kp,n])=>`<tr><td>${kp}</td><td>${n}</td><td>${Math.round(n/mistakes.length*100)}%</td></tr>`).join("")+`</tbody></table></div>`;
  out.innerHTML=html;
}
// ⑦ 真题特训
function genDrill(weakest){
  const out=document.getElementById("drillOut"); let kp=document.getElementById("drillKp").value;
  if(weakest){ const w=computeWeak(); if(!w.length){ out.innerHTML='<p class="mut">错题库为空，先用起来攒数据～</p>'; return; } kp=w[0][0]; }
  if(!kp){ out.innerHTML='<p class="mut">请选择知识点。</p>'; return; }
  const set=BANK[kp];
  out.innerHTML=`<div class="drill"><h3>针对「${kp}」的三题递进</h3>`+["基础","变式","拔高"].map(l=>`<div class="q"><b>[${l}]</b> ${set[l].q}<br><span class="ok">答案：${set[l].a}</span><br><span class="mut">解析：${set[l].h}</span></div>`).join("")+`</div>`;
}
// ⑦-2 中考压轴冲刺卷
function genZhongkao(){
  const out=document.getElementById("zkOut");
  const keys=Object.keys(BANK).filter(k=>k.indexOf("中考·压轴")===0);
  if(!keys.length){ out.innerHTML='<p class="mut">该科目暂未内置中考压轴专题，请用「⑦真题特训」针对性练习</p>'; return; }
  let html=`<div class="drill"><h3>🎯 中考压轴冲刺卷（每个专题 1 道拔高题，共 ${keys.length} 题）</h3>`;
  keys.forEach((k,i)=>{ const it=BANK[k]["拔高"]; html+=`<div class="q"><b>[${i+1}. ${k}]</b> ${it.q}<br><span class="ok">答案：${it.a}</span><br><span class="mut">解析：${it.h}</span></div>`; });
  html+=`<p class="mut">练习建议：先自练，再回到「⑦真题特训」按薄弱点反复刷基础+变式+拔高三题闭环。</p></div>`;
  out.innerHTML=html;
}
// ⑤-2 拍照/上传：Tesseract.js 实装 OCR（中英文 chi_sim+eng）
// ⑤-2 拍照/上传：Tesseract.js 实装 OCR（中英文 chi_sim+eng），支持多张 + 摄像头
function openFile(multiple, useCamera){
  const w=document.getElementById("ocrWrap"); if(w) w.style.display="block";
  const inp=document.createElement("input"); inp.type="file"; inp.accept="image/*"; inp.multiple=!!multiple;
  if(useCamera && navigator.mediaDevices) inp.capture="environment";
  inp.onchange=()=>{
    const files=inp.files? Array.from(inp.files):[];
    if(!files.length) return;
    setOcrStatus("⏳ 准备识别 "+files.length+" 张图片…");
    Promise.all(files.map((f,i)=>runOCR(f, i+1, files.length)))
      .then(texts=>{
        let out=""; texts.forEach((t,i)=>{ if(t) out += (out?"\n\n":"") + "【图"+(i+1)+"】\n" + t; });
        document.getElementById("ocrText").value=out;
        setOcrStatus("✅ 共识别 "+files.length+" 张，"+out.length+" 字。可编辑后「存入错题」或「回填批改框」。");
      })
      .catch(e=>setOcrStatus("❌ 识别失败："+(e&&e.message||e)));
  };
  inp.click();
}
function photoIn(){ openFile(false,false); }      // 兼容旧调用
function photoCamera(){ openFile(false,true); }   // 手机直接调起摄像头
function photoMulti(){ openFile(true,false); }     // 多选图片一次识别
let _tessPromise=null, _tessLocal=false, _tessUnavailable=false;
function ensureTesseract(){
  if(window.Tesseract) return Promise.resolve();
  // 内置兜底：引擎确实不可用时，直接拒绝并给出友好指引，避免反复失败拖垮体验
  if(_tessUnavailable) return Promise.reject(new Error("OCR 引擎暂不可用：请联网首次使用（浏览器会缓存，下次离线可用），或使用含 vendor 的「本地OCR版」离线文件夹"));
  if(_tessPromise) return _tessPromise;
  const load=src=>new Promise((res,rej)=>{ const s=document.createElement("script"); s.src=src; s.onload=()=>res(); s.onerror=()=>rej(new Error("load fail:"+src)); document.head.appendChild(s); });
  // 轻量离线策略：本地 vendor 优先（本地OCR版/离线文件夹），否则 CDN（单文件App首次即用），二者皆失败则标记不可用
  _tessPromise=new Promise((res,rej)=>{
    load("vendor/tesseract.min.js").then(()=>{ _tessLocal=true; res(); })
      .catch(()=>load("https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js").then(res).catch(()=>{ _tessUnavailable=true; rej(new Error("OCR 引擎加载失败：请联网后重试，或使用「本地OCR版」离线文件夹")); }));
  });
  return _tessPromise;
}
function setOcrStatus(x){ const e=document.getElementById("ocrStatus"); if(e) e.innerHTML=x; }
function runOCR(file, idx, total){
  idx=idx||1; total=total||1;
  return ensureTesseract().then(()=>new Promise((resolve,reject)=>{
    const enhance=!!(document.getElementById("ocrEnhance")&&document.getElementById("ocrEnhance").checked);
    const doRecog=src=>{
      setOcrStatus("🔍 识别第 "+idx+"/"+total+" 张… 0%");
      const opts={ logger: m=>{ if(m.status==="recognizing text") setOcrStatus("🔍 识别第 "+idx+"/"+total+" 张… "+Math.round(m.progress*100)+"%"); } };
      if(_tessLocal){ opts.workerPath="vendor/worker.min.js"; opts.corePath="vendor/tesseract-core.wasm.js"; opts.langPath="vendor/"; }
      Tesseract.recognize(src, "chi_sim+eng", opts)
        .then(({data})=>resolve((data.text||"").trim()))
        .catch(reject);
    };
    if(enhance){
      setOcrStatus("🛠 第 "+idx+" 张增强预处理（灰度+二值化）…");
      preprocessImage(file).then(c=>doRecog(c)).catch(()=>{ setOcrStatus("⚠️ 预处理失败，改用原图"); doRecog(file); });
    } else doRecog(file);
  }));
}
function preprocessImage(file){
  return new Promise((resolve,reject)=>{
    const img=new Image(); const url=URL.createObjectURL(file);
    img.onload=()=>{ try{
      let w=img.width, h=img.height; const MAX=2400; const s=Math.min(1,MAX/Math.max(w,h));
      w=Math.round(w*s); h=Math.round(h*s);
      const cv=document.createElement('canvas'); cv.width=w; cv.height=h;
      const ctx=cv.getContext('2d'); ctx.drawImage(img,0,0,w,h);
      const d=ctx.getImageData(0,0,w,h), p=d.data;
      for(let i=0;i<p.length;i+=4){ const g=0.299*p[i]+0.587*p[i+1]+0.114*p[i+2]; p[i]=p[i+1]=p[i+2]=g; }
      const hist=new Array(256).fill(0); for(let i=0;i<p.length;i+=4) hist[p[i]]++;
      let total=w*h, sum=0; for(let i=0;i<256;i++) sum+=i*hist[i];
      let sumB=0, wB=0, mx=0, thr=127;
      for(let i=0;i<256;i++){ wB+=hist[i]; if(wB===0) continue; const wF=total-wB; if(wF===0) break; sumB+=i*hist[i]; const mB=sumB/wB, mF=(sum-sumB)/wF; const bet=wB*wF*(mB-mF)*(mB-mF); if(bet>=mx){ mx=bet; thr=i; } }
      for(let i=0;i<p.length;i+=4){ const v=p[i]>=thr?255:0; p[i]=p[i+1]=p[i+2]=v; }
      ctx.putImageData(d,0,0); URL.revokeObjectURL(url); resolve(cv);
    }catch(e){ URL.revokeObjectURL(url); reject(e); } };
    img.onerror=()=>{ URL.revokeObjectURL(url); reject(new Error('图片读取失败')); };
    img.src=url;
  });
}

function ocrToMistake(){
  const t=(document.getElementById('ocrText').value||'').trim();
  if(!t){ alert('还没有识别结果'); return; }
  document.getElementById('mText').value=t;
  try{ if(window.QK) QK.logFlywheel(t, ''); }catch(e){}
  const tb=document.querySelector('.tabs button[data-t="录入错题"]'); if(tb) tb.click();
  setOcrStatus('已填入「录入错题」，请选择知识点与错因后点「存入错题库」。');
}
function ocrToPigai(){
  const t=(document.getElementById('ocrText').value||'').trim();
  if(!t){ alert('还没有识别结果'); return; }
  document.getElementById('pgInput').value=t;
  setOcrStatus('已回填「作业批改」框。如需批改，请按 题|学生答案|标准答案 用 | 分隔后点「批改」。');
}
function ocrCopy(){
  const t=document.getElementById('ocrText').value||'';
  if(!t) return;
  function fc(){ const el=document.getElementById('ocrText'); el.select(); try{ document.execCommand('copy'); setOcrStatus('📋 已复制'); }catch(e){} }
  if(navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(t).then(()=>setOcrStatus('📋 已复制')).catch(fc); }
  else fc();
}
// OCR_HOOK: 接 OCR 时在此回填 document.getElementById("pgInput").value = 识别文本;
// 初始化
document.getElementById("tabs").addEventListener("click",e=>{
  if(e.target.tagName!=="BUTTON") return;
  document.querySelectorAll(".tabs button").forEach(b=>b.classList.remove("on"));
  document.querySelectorAll(".card").forEach(c=>c.classList.remove("on"));
  e.target.classList.add("on"); document.getElementById(e.target.dataset.t).classList.add("on");
});
rebuildVerSel(); rebuildGradeSel(); rebuildKpSelects(); rebuildErrSel(); buildSubjBar(); updateHeaders(); renderAll();
