<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>全科提分导师 · 在线体验（9 科 · 小学+初中全覆盖）</title>
<style>
  * { box-sizing: border-box; }
  body { margin:0; font-family:-apple-system,"Microsoft YaHei",sans-serif; background:#f5f7fa; color:#1f2937; }
  header { background:#2563eb; color:#fff; padding:16px 24px; }
  header h1 { margin:0; font-size:20px; }
  header p { margin:6px 0 0; opacity:.9; font-size:13px; }
  .wrap { max-width:980px; margin:16px auto; padding:0 16px; }
  .tabs { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
  .tabs button { background:#fff; border:1px solid #cbd5e1; color:#334155; border-radius:8px; padding:8px 12px; font-size:13px; cursor:pointer; }
  .tabs button.on { background:#2563eb; color:#fff; border-color:#2563eb; }
  .card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:16px; box-shadow:0 1px 3px rgba(0,0,0,.04); display:none; }
  .card.on { display:block; }
  .card h2 { margin:0 0 12px; font-size:15px; color:#2563eb; }
  label { display:block; font-size:13px; margin:8px 0 4px; color:#374151; }
  input,select,textarea { width:100%; padding:8px 10px; border:1px solid #d1d5db; border-radius:8px; font-size:13px; }
  textarea { resize:vertical; min-height:64px; }
  button.act { background:#2563eb; color:#fff; border:0; border-radius:8px; padding:9px 14px; font-size:13px; cursor:pointer; margin-top:10px; }
  button.sec { background:#6b7280; color:#fff; border:0; border-radius:8px; padding:9px 14px; font-size:13px; cursor:pointer; margin-top:10px; margin-left:6px; }
  button.ghost { background:#fff; color:#2563eb; border:1px solid #2563eb; border-radius:8px; padding:8px 12px; font-size:13px; cursor:pointer; margin-top:8px; margin-left:6px; }
  .row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  table { width:100%; border-collapse:collapse; font-size:12px; margin-top:8px; }
  th,td { border:1px solid #e5e7eb; padding:6px; text-align:left; }
  th { background:#f1f5f9; }
  .bar { height:14px; background:#dbeafe; border-radius:7px; overflow:hidden; margin-top:4px; }
  .bar > i { display:block; height:100%; background:#2563eb; }
  .q { background:#f8fafc; border-left:3px solid #2563eb; padding:8px 10px; margin:8px 0; border-radius:0 8px 8px 0; }
  .q b { color:#1d4ed8; }
  .tag { display:inline-block; background:#fee2e2; color:#b91c1c; font-size:11px; padding:1px 6px; border-radius:6px; }
  .ok { color:#16a34a; font-size:12px; }
  .mut { color:#6b7280; font-size:12px; }
  .drill { background:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:12px; margin-top:10px; }
  .drill h3 { margin:0 0 8px; font-size:14px; color:#b45309; }
  .nav { font-size:12px; color:#6b7280; margin-bottom:6px; }
  .guide { background:#eff6ff; border:1px solid #bfdbfe; border-radius:12px; padding:14px; margin-bottom:14px; }
  .guide h2 { color:#1d4ed8; margin:0 0 8px; font-size:15px; }
  .guide p { font-size:13px; line-height:1.7; margin:0; }
  .badge { display:inline-block; background:#fde68a; color:#92400e; font-size:11px; padding:1px 7px; border-radius:6px; margin-left:6px; }
  @media (max-width:640px){
    header{padding:12px 14px;} header h1{font-size:17px;} header p{font-size:12px;}
    .wrap{margin:10px auto;} .card{padding:12px;}
    .tabs button{flex:1 1 30%; text-align:center; padding:8px 6px;}
    button.act,button.sec,button.ghost{width:100%; margin-left:0; margin-top:8px;}
    input,select,textarea{font-size:14px;}
  }
  .vbar{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:10px 14px;margin-bottom:14px;font-size:13px;}
  .vbar select{width:auto;display:inline-block;padding:4px 8px;margin:0 4px;}
/*QUANKE_GATE_CSS_START*/
  .gate{display:flex;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:9999;align-items:center;justify-content:center;padding:16px;}
  .gatecard{background:#fff;border-radius:16px;max-width:440px;width:100%;padding:24px;box-shadow:0 20px 60px rgba(0,0,0,.3);max-height:90vh;overflow:auto;}
  .gatecard h2{margin:0 0 14px;font-size:18px;color:#0f172a;}
  .gatecard label{display:block;font-size:13px;margin:10px 0 4px;color:#334155;}
  .gatecard input[type=text],.gatecard input[type=password],.gatecard input:not([type]){width:100%;padding:9px 10px;border:1px solid #cbd5e1;border-radius:8px;box-sizing:border-box;}
  .gatecard .row{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;align-items:center;}
  .gatecard a{color:#2563eb;cursor:pointer;}
  .plans{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;}
  .plan{display:flex;align-items:center;gap:4px;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;font-size:13px;cursor:pointer;}
  .plan input{margin:0;}
  .act{background:#16a34a;color:#fff;border:none;border-radius:8px;padding:9px 14px;cursor:pointer;font-size:14px;}
  .ghost{background:#fff;border:1px solid #cbd5e1;color:#334155;border-radius:8px;padding:8px 12px;cursor:pointer;font-size:13px;}
  .mut{color:#64748b;font-size:12px;line-height:1.6;}
  #acctBar{display:flex;justify-content:flex-end;gap:10px;align-items:center;font-size:13px;color:#334155;margin-bottom:8px;}
  #acctBar a{color:#2563eb;cursor:pointer;}
  #payQR{margin-top:10px;display:flex;flex-direction:column;align-items:center;}
  #toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:#0f172a;color:#fff;padding:10px 16px;border-radius:10px;font-size:13px;opacity:0;pointer-events:none;transition:.25s;z-index:10000;max-width:90vw;}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
/*QUANKE_GATE_CSS_END*/
</style>
</head>
<body>
<header>
  <h1>全科提分 · 9 科离线包（小学 + 初中全覆盖）</h1>
  <p>9 科合一 · 分层出题 / 作业批改 / 错题归因 / 学情周报 / 真题特训 / 中考专练 · 拍照 OCR · 教材版本+年级筛选 · 账号与学习数据云端同步<span class="badge">手机电脑都能用</span></p>
</header>

<div class="wrap">
  <div class="guide">
    <h2>📘 家长使用指南（3 步上手）</h2>
    <p>
      ① <b>录入错题</b>：把孩子做错的题粘贴进来，选好知识点和错因（可点「载入示例」先体验）。<br>
      ② <b>看薄弱 Top3</b>：系统自动统计最弱的 3 个知识点，并画进度条。<br>
      ③ <b>真题特训 / 中考专练</b>：一键生成「基础+变式+拔高」三题，孩子练会后点「再测通过」。<br>
      <span class="mut">账号、错题与学习数据保存在本站服务端数据库，换设备登录自动同步；也可随时导出 JSON/CSV 发给老师，或接入 WorkBuddy 全科员工做长期追踪。</span>
    </p>
  </div>
  <div class="subjbar" id="subjbar"></div>
  <div class="vbar">📚 <b id="vbarSubj">数学</b> · 教材版本：<select id="vSel" onchange="switchVer(this.value)"></select> ｜ 年级/学期：<select id="gSel" onchange="GSEL=this.value; rebuildKpSelects();"></select> <span class="mut">（按本版本编排，仅显示该年级知识点）</span></div>
  <div class="tabs" id="tabs">
    <button data-t="录入错题" class="on">①录入错题</button>
    <button data-t="错题库">②错题库</button>
    <button data-t="薄弱Top3">③薄弱Top3</button>
    <button data-t="分层出题">④分层出题</button>
    <button data-t="作业批改">⑤作业批改</button>
    <button data-t="学情周报">⑥学情周报</button>
    <button data-t="真题特训">⑦真题特训</button>
    <button data-t="中考专练">🎯中考专练</button>
  </div>

  <!-- ① 录入错题 -->
  <div class="card on" id="录入错题">
    <h2>① 录入错题（Skill 3 输入）</h2>
    <label>错题原文 / 截图转写</label>
    <textarea id="mText" placeholder="例如：解方程 x²-5x+6=0 时写成 x=5±√25-24 然后算错"></textarea>
    <label>知识点（选最贴近的）</label>
    <select id="mKp"></select>
    <label>难度档</label>
    <select id="mLevel"><option value="A">A 学优</option><option value="B" selected>B 中等</option><option value="C">C 薄弱</option></select>
    <label>错因标签</label>
    <select id="mErr"></select>
    <div class="row">
      <button class="act" onclick="addMistake()">存入错题库</button>
      <button class="ghost" onclick="loadDemo()">载入示例错题</button>
    </div>
  </div>

  <!-- ② 错题库 -->
  <div class="card" id="错题库">
    <h2>② 错题库（云端同步 · 换设备不丢）</h2>
    <div class="row">
      <button class="sec" onclick="exportJSON()">导出 JSON</button>
      <button class="sec" onclick="exportCSV()">导出 CSV</button>
      <button class="sec" onclick="clearAll()">清空</button>
    </div>
    <div style="overflow:auto; max-height:300px;">
      <table id="mistakeTbl"><thead><tr><th>日期</th><th>知识点</th><th>档</th><th>错因</th><th>再测</th></tr></thead><tbody></tbody></table>
    </div>
  </div>

  <!-- ③ 薄弱Top3 -->
  <div class="card" id="薄弱Top3">
    <h2>③ 薄弱 Top3（Skill 3 输出）</h2>
    <div id="weakBox"><p class="mut">还没有数据，先录入或载入示例错题。</p></div>
  </div>

  <!-- ④ 分层出题 -->
  <div class="card" id="分层出题">
    <h2>④ 分层出题（Skill 1）</h2>
    <div class="nav">档位映射：A学优→拔高题，B中等→变式题，C薄弱→基础题</div>
    <label>知识点</label><select id="chKp"></select>
    <label>要出的档位</label>
    <select id="chLevel"><option value="A">A 学优（拔高）</option><option value="B" selected>B 中等（变式）</option><option value="C">C 薄弱（基础）</option></select>
    <div class="row"><button class="act" onclick="genChuti()">出题</button><button class="ghost" onclick="genChutiAll()">三档全出</button></div>
    <div id="chOut"></div>
  </div>

  <!-- ⑤ 作业批改 -->
  <div class="card" id="作业批改">
    <h2>⑤ 作业批改（Skill 2）</h2>
    <div class="nav">每行：题目 | 学生答案 | 标准答案（用 | 分隔）</div>
    <textarea id="pgInput" placeholder="如：&#10;求(-3)+7 | 3 | 4&#10;解2x+3=11 | x=3 | x=4&#10;√16 | 8 | 4"></textarea>
    <div class="row"><button class="act" onclick="pigai()">批改</button><button class="ghost" onclick="loadPgDemo()">载入示例</button><button class="ghost" onclick="photoCamera()">📷 拍照</button><button class="ghost" onclick="photoMulti()">📁 上传图片(可多张)</button></div>
    <p class="mut" id="pgTip">已实装 Tesseract.js 拍照 OCR（中英文）：点「📷 拍照/上传」选图后自动识别，结果可编辑并一键「存入错题」或「回填批改框」。首次识别需联网下载引擎（约几十 MB，浏览器缓存后离线可复用）。</p>
<div id="ocrWrap" style="display:none; margin-top:10px; border:1px dashed #cbd5e1; border-radius:10px; padding:10px; background:#f8fafc;">
  <div id="ocrStatus" class="mut">准备识别…</div>
  <textarea id="ocrText" style="margin-top:6px; min-height:90px;" placeholder="识别结果会显示在这里，可手动修正错别字。"></textarea>
  <label style="display:block; font-size:12px; margin:6px 0 0; color:#374151;"><input type="checkbox" id="ocrEnhance"> ✨ 增强模式（灰度+二值化，提升手写/拍照识别率）</label>
  <div class="row">
    <button class="ghost" onclick="ocrToMistake()">📥 存入「录入错题」</button>
    <button class="ghost" onclick="ocrToPigai()">↩️ 回填「作业批改」</button>
    <button class="ghost" onclick="ocrCopy()">📋 复制</button>
    <button class="ghost" onclick="flyReport()">📡 上报纠错</button>
  </div>
</div>
    <div id="pgOut"></div>
  </div>

  <!-- ⑥ 学情周报 -->
  <div class="card" id="学情周报">
    <h2>⑥ 学情周报（Skill 4）</h2>
    <p class="mut">基于当前错题库自动生成（可视为单人/班级错因聚合）。</p>
    <button class="act" onclick="genZhoubao()">生成周报</button>
    <div id="zbOut"></div>
  </div>

  <!-- ⑦ 真题特训 -->
  <div class="card" id="真题特训">
    <h2>⑦ 真题特训（Skill 5：基础+变式+拔高）</h2>
    <label>选知识点（留空=自动取最薄弱）</label>
    <div class="row">
      <select id="drillKp" style="flex:1;"></select>
      <button class="act" onclick="genDrill()">生成三题</button>
      <button class="ghost" onclick="genDrill(true)">针对最薄弱</button>
    </div>
    <div id="drillOut"></div>
  </div>

  <!-- 🎯 中考专练 -->
  <div class="card" id="中考专练">
    <h2>🎯 中考压轴专练（付费核心内容）</h2>
    <p class="mut">覆盖 10 大中考压轴专题：二次函数与几何综合、动点与存在性、几何旋转折叠、圆与相似、新定义运算、函数与面积最值、三角形四边形综合、反比例函数、锐角三角函数应用、根与系数关系。一键生成冲刺卷。</p>
    <button class="act" onclick="genZhongkao()">生成中考压轴冲刺卷</button>
    <div id="zkOut"></div>
  </div>

  <p class="mut" style="text-align:center; margin:18px 0;">
    本作品对应《全科提分员工手册》全部 5 个 Skill，覆盖 9 大学科。账号与学习数据保存在本站服务端数据库（站内账号登录后自动同步），仍可随时导出 JSON/CSV 接入 WorkBuddy 错题库。
  </p>
</div>

<!--QUANKE_GATE_START-->
<div id="gate" class="gate">
  <div class="gatecard">
    <h2 id="gateTitle">正在校验使用授权…</h2>
    <div id="gateView"><p class="mut">首次打开请稍候。若长时间停留在此页，请确认浏览器已启用 JavaScript。</p></div>
    <noscript><p class="mut">本页面需要 JavaScript 才能校验使用授权，请启用后刷新。</p></noscript>
  </div>
</div>
<!--QUANKE_GATE_END-->
<script>
// ===================== 全小学+初中题库（基础/变式/拔高） =====================
const SUBJECTS = {"数学":{"errs":["计算错误", "概念混淆", "审题偏差", "步骤遗漏", "公式记错", "模型不会建", "符号搞错", "时间不够", "其他"],"versions":{"人教版":{"bank":{
  // ---------- 小学 ----------
  "小学·整数四则运算": {"基础":{q:"计算 125×8÷4",a:"250",h:"125×8=1000，1000÷4=250"},"变式":{q:"45+55×2-30",a:"125",h:"先乘：55×2=110，45+110-30=125"},"拔高":{q:"一个数÷12=15余7，求这个数",a:"187",h:"被除数=除数×商+余数=12×15+7=187"}},
  "小学·小数加减乘除": {"基础":{q:"3.2+1.85",a:"5.05",h:"小数点对齐：3.20+1.85=5.05"},"变式":{q:"2.4×0.5",a:"1.2",h:"24×5=120，两位小数→1.20"},"拔高":{q:"12.6÷0.3",a:"42",h:"同乘10：126÷3=42"}},
  "小学·分数加减": {"基础":{q:"1/4+1/4",a:"1/2",h:"同分母相加=2/4=1/2"},"变式":{q:"3/5+1/10",a:"7/10",h:"6/10+1/10=7/10"},"拔高":{q:"1-2/3+1/6",a:"1/2",h:"1/3+1/6=2/6+1/6=3/6=1/2"}},
  "小学·分数乘除": {"基础":{q:"2/3×3/4",a:"1/2",h:"分子分母约分=6/12=1/2"},"变式":{q:"3/4÷1/2",a:"3/2（或1.5）",h:"除以分数=乘倒数：3/4×2=3/2"},"拔高":{q:"一个数的3/5是12，求这个数",a:"20",h:"12÷3/5=12×5/3=20"}},
  "小学·百分数": {"基础":{q:"0.25 = ?%",a:"25%",h:"小数×100"},"变式":{q:"40% = 分数",a:"2/5",h:"40/100=2/5"},"拔高":{q:"200元的20%是多少",a:"40元",h:"200×0.2=40"}},
  "小学·比和比例": {"基础":{q:"化简 12:18",a:"2:3",h:"同除以6"},"变式":{q:"若 a:b=3:4，b=12，求a",a:"9",h:"a=12×3/4=9"},"拔高":{q:"比例尺1:5000，图上3cm实际?米",a:"150米",h:"3×5000=15000cm=150m"}},
  "小学·百分数应用题": {"基础":{q:"原价100，打8折，现价?",a:"80元",h:"100×0.8=80"},"变式":{q:"某数增加20%是120，原数?",a:"100",h:"120÷1.2=100"},"拔高":{q:"浓度20%盐水100g，含盐?",a:"20g",h:"100×20%=20"}},
  "小学·简易方程": {"基础":{q:"x+5=12，x=?",a:"7",h:"x=12-5"},"变式":{q:"3x=24，x=?",a:"8",h:"x=24÷3"},"拔高":{q:"2x+3=15，x=?",a:"6",h:"2x=12"}},
  "小学·长方形正方形": {"基础":{q:"长5宽3长方形面积",a:"15",h:"5×3=15"},"变式":{q:"边长4正方形周长",a:"16",h:"4×4=16"},"拔高":{q:"长方形周长20，长7，宽?",a:"3",h:"(20-2×7)/2=3"}},
  "小学·三角形梯形面积": {"基础":{q:"底6高4三角形面积",a:"12",h:"6×4÷2=12"},"变式":{q:"上底3下底5高4梯形面积",a:"16",h:"(3+5)×4÷2=16"},"拔高":{q:"平行四边形底8高3面积",a:"24",h:"8×3=24"}},
  "小学·圆": {"基础":{q:"r=2圆周长(π=3.14)",a:"12.56",h:"2×3.14×2=12.56"},"变式":{q:"r=3圆面积",a:"28.26",h:"3.14×9=28.26"},"拔高":{q:"d=10半圆周长",a:"25.7",h:"3.14×5+10=25.7"}},
  "小学·长方体正方体": {"基础":{q:"棱长2正方体体积",a:"8",h:"2³=8"},"变式":{q:"长3宽2高1长方体表面积",a:"22",h:"2(3×2+3×1+2×1)=22"},"拔高":{q:"体积24，长宽高可能是?",a:"如2×3×4",h:"举例乘积为24"}},
  "小学·圆柱圆锥": {"基础":{q:"底半径2高3圆柱体积",a:"37.68",h:"3.14×4×3=37.68"},"变式":{q:"同底同高圆锥体积",a:"12.56",h:"37.68÷3=12.56"},"拔高":{q:"r=2高5圆柱侧面积",a:"62.8",h:"2×3.14×2×5=62.8"}},
  "小学·平均数": {"基础":{q:"3,5,7的平均数",a:"5",h:"(3+5+7)/3=5"},"变式":{q:"四数平均8，其三为6,7,9，第四?",a:"10",h:"32-22=10"},"拔高":{q:"甲组平均80(5人)乙组平均90(5人)总平均",a:"85",h:"(400+450)/10=85"}},
  "小学·统计图表": {"基础":{q:"条形图主要表示?",a:"数量多少",h:"—"},"变式":{q:"扇形图表示?",a:"各部分占比",h:"—"},"拔高":{q:"数据12,15,15,20的众数",a:"15",h:"出现最多"}},
  "小学·可能性": {"基础":{q:"抛硬币正面概率",a:"1/2",h:"—"},"变式":{q:"掷骰子点数>4概率",a:"1/3",h:"5,6两点"},"拔高":{q:"袋3红2白，摸红概率",a:"3/5",h:"3/(3+2)"}},
