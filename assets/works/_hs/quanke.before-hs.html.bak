/* QUANKE_GATE_V2
 * 全科提分 · 注册 / 7 天试用 / 微信支付门禁（唯一实现，供全部离线页注入）
 * ----------------------------------------------------------------------
 * 设计约束：
 *  1) 只用 ES5（file:// 与旧内核 WebView 都能跑）；
 *  2) 默认 fail-closed —— #gate 在 CSS 里就是显示的，只有 JS 判定有权才隐藏它；
 *  3) 权益天数一律以服务端 /status、/claim 返回的 plan/days 为准，前端不自己算套餐；
 *  4) 所有用户可控文本一律走 textContent，杜绝 innerHTML 注入。
 * 对外暴露 window.QK，供数据飞轮等扩展模块复用。
 */
(function () {
  "use strict";
  if (typeof window === "undefined" || typeof document === "undefined") return;
  if (window.QK && window.QK.version === "2.0.0") return; // 防重复注入

  var AUTH_KEY = "quanke_auth_v1";
  var USERS_KEY = "quanke_users_v1";
  var FLY_KEY = "quanke_flywheel_v1";
  var DEV_KEY = "quanke_dev_v1";
  var TRIAL_DAYS = 7;
  var PAY_POLL_MS = 2500;
  var PAY_POLL_MAX = 40; // 最多轮询 100 秒，避免后台常驻定时器
  var PLANS = [
    { id: "m", name: "月卡会员", price: "¥29" },
    { id: "q", name: "季卡会员", price: "¥79" },
    { id: "y", name: "年卡会员", price: "¥299" }
  ];
  // 阶段 B：支付改走主站微信支付兼容层（/api/works/pay/*）。
  // 仍保留 window.QUANKE_PAY_API 覆盖点，便于本地联调指向其它后端。
  var PAY_API_BASE = (window.QUANKE_PAY_API || "/api/works/pay/").replace(/\/?$/, "/");

  /* ---------------- 站内云端桥接（阶段 B：共用主站数据库） ----------------
   * 账号 / 试用 / 会员权益 / 错题库 / 飞轮的**权威数据在主站国产 PostgreSQL**；
   * localStorage 只作为同步缓存，这样原有全同步的门禁判定不会被异步 API 竞态锁死。
   *  - 启动时 bootstrap() 拉取云端状态覆盖本地缓存并重绘；
   *  - 注册 / 登录 / 找回走 /api/works/auth（服务端 PBKDF2 加盐 + 会话 cookie）；
   *  - 错题 / 飞轮写入时 debounce 推送 /api/works/data；
   *  - 支付走 /api/works/pay/*，权益由服务端幂等发放，前端只负责展示。
   * 客户端永远不能写 paidUntil：服务端只接受错题与飞轮数据。
   */
  var CLOUD_API = "/api/works/";
  var QKCloud = {
    ready: false,
    loggedIn: false,
    booting: false,
    online: true,
    _pending: {},
    _timer: null,
    api: function (path, method, body) {
      return fetch(CLOUD_API + path, {
        method: method || "GET",
        headers: body ? { "Content-Type": "application/json" } : undefined,
        body: body ? JSON.stringify(body) : undefined,
        credentials: "same-origin",
        cache: "no-store"
      }).then(function (r) {
        return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; });
      });
    },
    err: function (o, fallback) {
      return (o && o.j && o.j.error) || fallback || "网络异常，请稍后重试";
    },
    /* 合并 600ms 内的写操作，避免每次点击都打一次接口 */
    queue: function (patch) {
      var k;
      for (k in patch) if (Object.prototype.hasOwnProperty.call(patch, k)) this._pending[k] = patch[k];
      var self = this;
      if (this._timer) clearTimeout(this._timer);
      this._timer = setTimeout(function () { self.flush(); }, 600);
    },
    flush: function () {
      var payload = this._pending;
      this._pending = {};
      this._timer = null;
      if (!this.loggedIn || !Object.keys(payload).length) return;
      var self = this;
      this.api("data", "POST", payload).catch(function () { self.online = false; });
    },
    syncMistakes: function (subject, records) {
      this.queue({ mistakes: { subject: subject, records: records || [] } });
    },
    syncFly: function (arr) {
      this.queue({ flywheel: arr || [] });
    },
    /* 用云端权威状态覆盖本地缓存；无会话时保持本地状态，离线仍可试用 */
    bootstrap: function () {
      var self = this;
      return this.api("auth", "GET").then(function (o) {
        self.ready = true;
        if (!o.ok || !o.j || !o.j.loggedIn) { self.loggedIn = false; return false; }
        var s = o.j;
        self.booting = true;
        try {
          localStorage.setItem(AUTH_KEY, JSON.stringify(s.auth || {}));
          var users = {};
          users[s.account] = {
            passHash: "", ts: (s.auth && s.auth.ts) || now(),
            createdAt: (s.auth && s.auth.ts) || now(),
            isPaid: !!(s.auth && s.auth.isPaid), plan: (s.auth && s.auth.plan) || null,
            paidTs: (s.auth && s.auth.paidTs) || 0, paidUntil: (s.auth && s.auth.paidUntil) || 0
          };
          localStorage.setItem(USERS_KEY, JSON.stringify(users));
          var ms = s.mistakes || {};
          for (var subj in ms) if (Object.prototype.hasOwnProperty.call(ms, subj)) {
            localStorage.setItem("super9_" + subj + "_v1", JSON.stringify(ms[subj] || []));
          }
          localStorage.setItem(FLY_KEY, JSON.stringify(s.flywheel || []));
        } catch (e) { }
        self.booting = false;
        self.loggedIn = true;
        // 全局错题库变量与渲染函数（同页另一段脚本，顶层 let/function 可跨 script 访问）
        try { mistakes = load(); renderAll(); } catch (e2) { }
        try { if (window.QKFLY && window.QKFLY.renderFlyList) window.QKFLY.renderFlyList(); } catch (e3) { }
        try { updateFlyCount(); } catch (e4) { }
        _viewKey = "";
        renderGate();
        return true;
      }).catch(function () {
        self.ready = true; self.booting = false; self.online = false; return false;
      });
    },
    authRegister: function (user, pw) {
      var self = this;
      return this.api("auth", "POST", { action: "register", account: user, password: pw })
        .then(function (o) {
          if (!o.ok) throw new Error(self.err(o, "注册失败"));
          self.loggedIn = true;
          return true;
        });
    },
    authLogin: function (user, pw) {
      var self = this;
      return this.api("auth", "POST", { action: "login", account: user, password: pw })
        .then(function (o) {
          if (!o.ok) throw new Error(self.err(o, "登录失败"));
          self.loggedIn = true;
          return self.bootstrap();
        });
    },
    authLogout: function () {
      this.loggedIn = false;
      return this.api("auth", "POST", { action: "logout" }).catch(function () { });
    },
    authReset: function (user, pw, orderId) {
      var self = this;
      return this.api("auth", "POST", {
        action: "reset", account: user, password: pw, orderId: orderId || ""
      }).then(function (o) {
        if (!o.ok) throw new Error(self.err(o, "重设失败"));
        self.loggedIn = true;
        return self.bootstrap();
      });
    }
  };
  window.QKCloud = QKCloud;

  function $(id) { return document.getElementById(id); }
  function now() { return Date.now(); }
  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }
  function djb2(s) {
    var h = 5381;
    for (var i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0;
    return h.toString(16);
  }
  function hashPw(pw, user) { return djb2("qk::" + user + "::" + pw); }
  function safeText(v) { return v == null ? "" : String(v); }

  function loadJSON(key, dflt) {
    try { var v = JSON.parse(localStorage.getItem(key)); return v == null ? dflt : v; } catch (e) { return dflt; }
  }
  function saveJSON(key, v) {
    try { localStorage.setItem(key, JSON.stringify(v)); } catch (e) { }
    // 飞轮数据同步到主站数据库；bootstrap 回写缓存时不重复上行
    try {
      var c = window.QKCloud;
      if (c && c.ready && c.loggedIn && !c.booting && key === FLY_KEY) c.syncFly(v);
    } catch (e2) { }
  }

  function loadAuth() { var a = loadJSON(AUTH_KEY, null); return a && typeof a === "object" ? a : null; }
  function saveAuth(a) { saveJSON(AUTH_KEY, a); }
  function loadUsers() { var u = loadJSON(USERS_KEY, {}); return u && typeof u === "object" ? u : {}; }
  function saveUsers(u) { saveJSON(USERS_KEY, u); }

  // 存储体检：聊天窗口内置预览/隐私模式下 localStorage 可能被禁用，
  // 写入会静默失败 → 之前会出现「注册成功却登录提示账号不存在」的假成功。
  var STORE_OK = (function () {
    try {
      var k = "quanke_probe_v1";
      localStorage.setItem(k, "1");
      var ok = localStorage.getItem(k) === "1";
      localStorage.removeItem(k);
      return ok;
    } catch (e) { return false; }
  })();
  var STORE_HINT = "当前环境无法保存本地缓存（常见于隐私/无痕模式）。账号数据已保存在服务端，请关闭无痕模式或换用普通浏览器窗口后重试。";
  function loadFly() { var a = loadJSON(FLY_KEY, []); return a && a.length ? a : []; }
  function saveFly(a) { saveJSON(FLY_KEY, a); }

  // 稳定设备标识：用于订单归属绑定（不采集任何个人信息）
  function deviceId() {
    var d = "";
    try { d = localStorage.getItem(DEV_KEY) || ""; } catch (e) { }
    if (!/^dev_[a-z0-9]{8,64}$/.test(d)) {
      d = "dev_" + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2) + now().toString(36);
      d = d.slice(0, 40);
      try { localStorage.setItem(DEV_KEY, d); } catch (e) { }
    }
    return d;
  }

  function trialEnd(a) { return a && a.ts ? a.ts + TRIAL_DAYS * 864e5 : 0; }
  function trialLeft(a) { return Math.max(0, Math.ceil((trialEnd(a) - now()) / 864e5)); }
  function paidEnd(a) {
    if (!a || !a.isPaid) return 0;
    return a.paidUntil || (a.paidTs ? a.paidTs + 30 * 864e5 : 0);
  }
  function hasAccess(a) {
    if (!a) return false;
    if (paidEnd(a) > now()) return true;
    return now() < trialEnd(a);
  }
  function fmtDate(t) {
    var d = new Date(t);
    return d.getFullYear() + "-" + ("0" + (d.getMonth() + 1)).slice(-2) + "-" + ("0" + d.getDate()).slice(-2);
  }
  function planName(id) {
    for (var i = 0; i < PLANS.length; i++) if (PLANS[i].id === id) return PLANS[i].name;
    return "会员";
  }
  function toast(msg) {
    var t = $("toast");
    if (!t) { t = el("div"); t.id = "toast"; document.body.appendChild(t); }
    t.textContent = safeText(msg);
    t.className = "show";
    clearTimeout(t._h);
    t._h = setTimeout(function () { t.className = ""; }, 2600);
  }

  /* ------------------------- 账号 ------------------------- */
  // 权益/试用起点都以「账号档案」为准，登录态只是指针：退出重登不会重置试用、也不会丢会员
  function register(user, pw) {
    if (!STORE_OK) { toast(STORE_HINT); return Promise.resolve(false); }
    user = String(user || "").trim();
    if (!user) { toast("请输入手机号/邮箱"); return Promise.resolve(false); }
    if (!pw || String(pw).length < 6) { toast("密码至少 6 位"); return Promise.resolve(false); }
    // 云端注册为权威；成功后才写本地缓存，服务端拒绝时不做「假成功」
    return QKCloud.authRegister(user, pw).then(function () {
      var rec = { passHash: hashPw(pw, user), ts: now(), createdAt: now(), isPaid: false, plan: null, paidTs: 0, paidUntil: 0 };
      var users = loadUsers();
      users[user] = rec;
      saveUsers(users);
      saveAuth({ phone: user, passHash: rec.passHash, ts: rec.ts, isPaid: false, plan: null, paidTs: 0, paidUntil: 0 });
      return true;
    }).catch(function (e) {
      toast(e && e.message ? e.message : "注册失败，请检查网络后重试");
      return false;
    });
  }
  function login(user, pw) {
    if (!STORE_OK) { toast(STORE_HINT); return Promise.resolve(false); }
    user = String(user || "").trim();
    if (!user) { toast("请输入手机号/邮箱"); return Promise.resolve(false); }
    // 密码由服务端加盐哈希校验；登录成功后 bootstrap 会用云端账号/权益/学习数据覆盖本地缓存
    return QKCloud.authLogin(user, pw).then(function () { return true; })
      .catch(function (e) {
        toast(e && e.message ? e.message : "登录失败，请检查网络后重试");
        return false;
      });
  }
  // 老版本只存了单条 auth、没有账号表：迁移成账号档案，保留原试用起点
  function migrate() {
    var a = loadAuth();
    if (!a || !a.phone) return;
    var users = loadUsers();
    if (!Object.prototype.hasOwnProperty.call(users, a.phone)) {
      users[a.phone] = {
        passHash: a.passHash || "", ts: a.ts || now(), createdAt: a.ts || now(),
        isPaid: !!a.isPaid, plan: a.plan || null, paidTs: a.paidTs || 0, paidUntil: a.paidUntil || 0
      };
      saveUsers(users);
    }
  }

  /* ------------------------- 门禁 UI ------------------------- */
  var _viewKey = "";
  function renderGate() {
    var gate = $("gate");
    if (!gate) return;
    var a = loadAuth();
    if (hasAccess(a)) {
      stopPayPoll();
      gate.style.display = "none";
      _viewKey = "";
      updateAcctBar();
      return;
    }
    gate.style.display = "flex";
    var view = !a ? "reg" : "upgrade";
    var key = view + "|" + (a ? (a.phone || "") + "|" + (a.isPaid ? "p" : "t") : "");
    if (key !== _viewKey) {
      _viewKey = key;
      $("gateTitle").textContent = !a ? "全科提分 · 注册即享 7 天免费试用" :
        (a.isPaid ? "会员已到期 · 续费继续使用" : "试用已结束 · 开通会员继续使用");
      var box = $("gateView");
      box.innerHTML = "";
      if (!a) box.appendChild(buildRegForm());
      else box.appendChild(buildUpgrade(a));
    }
    updateAcctBar();
  }

  function buildRegForm() {
    var wrap = el("div");
    var f = el("form");
    function field(labelText, inputType, placeholder) {
      f.appendChild(el("label", null, labelText));
      var i = el("input");
      i.type = inputType;
      if (placeholder) i.placeholder = placeholder;
      f.appendChild(i);
      return i;
    }
    var u = field("手机号 / 邮箱", "text", "用于登录与会员权益绑定");
    var p = field("密码", "password", "设置登录密码（至少 6 位）");
    var p2 = field("确认密码", "password", "");
    var row = el("div", "row");
    var bReg = el("button", "act", "注册并领取 7 天免费试用");
    bReg.type = "button";
    row.appendChild(bReg);
    f.appendChild(row);
    f.appendChild(el("p", "mut", "注册即同意《用户协议》。账号与学习数据将保存在本站服务端数据库并跨设备同步。试用期内全科功能免费；试用结束后需开通会员方可继续使用。"));

    var row2 = el("div", "row");
    var bLogin = el("button", "ghost", "已有账号？去登录");
    bLogin.type = "button";
    row2.appendChild(bLogin);
    f.appendChild(row2);

    bReg.onclick = function () {
      if (p.value !== p2.value) { toast("两次密码不一致"); return; }
      bReg.disabled = true;
      register(u.value, p.value).then(function (okFlag) {
        bReg.disabled = false;
        if (okFlag) { toast("注册成功，7 天试用已开启"); _viewKey = ""; renderGate(); }
      });
    };
    bLogin.onclick = function () { _viewKey = ""; showLogin(); };
    wrap.appendChild(f);
    return wrap;
  }

  function showLogin() {
    var gate = $("gate");
    if (!gate) return;
    gate.style.display = "flex";
    $("gateTitle").textContent = "登录 · 全科提分";
    var box = $("gateView");
    box.innerHTML = "";
    var f = el("form");
    f.appendChild(el("label", null, "手机号 / 邮箱"));
    var u = el("input"); u.type = "text"; f.appendChild(u);
    f.appendChild(el("label", null, "密码"));
    var p = el("input"); p.type = "password"; f.appendChild(p);
    var row = el("div", "row");
    var b = el("button", "act", "登录");
    b.type = "button";
    row.appendChild(b);
    var back = el("button", "ghost", "返回注册");
    back.type = "button";
    row.appendChild(back);
    f.appendChild(row);
    b.onclick = function () {
      b.disabled = true;
      login(u.value, p.value).then(function (okFlag) {
        b.disabled = false;
        if (okFlag) { toast("登录成功，数据已同步"); _viewKey = ""; renderGate(); }
      });
    };
    back.onclick = function () { _viewKey = ""; renderGate(); };
    box.appendChild(f);

    var help = el("p", "mut");
    help.style.fontSize = "12px";
    var forgot = el("a", null, "忘记密码？");
    forgot.href = "#";
    forgot.onclick = function (e) { e.preventDefault(); showForgot(); };
    help.appendChild(forgot);
    box.appendChild(help);
  }

  /* ------------------------- 找回密码 ------------------------- */
  // 离线单文件没有短信/邮箱验证码通道，所以身份核验分两档：
  //   服务端统一核验：本人登录态可直接重设；
  //   已付费账号换设备找回时要求一笔真实支付订单号（只读核验，不发权益、不叠加天数）。
  function resetPassword(user, pw, orderId) {
    if (!STORE_OK) { toast(STORE_HINT); return Promise.resolve(false); }
    user = String(user || "").trim();
    if (!pw || String(pw).length < 6) { toast("密码至少 6 位"); return Promise.resolve(false); }
    // 服务端校验：本人登录态，或该账号的一笔已支付订单号（换设备找回）
    return QKCloud.authReset(user, pw, orderId || "").then(function () { return true; })
      .catch(function (e) {
        toast(e && e.message ? e.message : "重设失败，请检查网络后重试");
        return false;
      });
  }

  function showForgot() {
    var gate = $("gate");
    if (!gate) return;
    gate.style.display = "flex";
    $("gateTitle").textContent = "找回密码 · 全科提分";
    var box = $("gateView");
    box.innerHTML = "";
    var f = el("form");
    f.appendChild(el("label", null, "手机号 / 邮箱"));
    var u = el("input"); u.type = "text"; u.placeholder = "注册时填写的手机号/邮箱"; f.appendChild(u);
    var row = el("div", "row");
    var bNext = el("button", "act", "下一步");
    bNext.type = "button";
    row.appendChild(bNext);
    var back = el("button", "ghost", "返回登录");
    back.type = "button";
    row.appendChild(back);
    f.appendChild(row);
    var tip = el("p", "mut"); tip.style.fontSize = "12px";
    f.appendChild(tip);
    back.onclick = function () { _viewKey = ""; showLogin(); };
    bNext.onclick = function () {
      if (!STORE_OK) { toast(STORE_HINT); return; }
      var user = String(u.value || "").trim();
      if (!user) { toast("请输入注册时使用的手机号/邮箱"); return; }
      var users = loadUsers();
      // 账号档案存在服务端，本机没有缓存不代表账号不存在；交给服务端核验
      var isPaid = Object.prototype.hasOwnProperty.call(users, user) ? !!users[user].isPaid : false;
      showReset(user, isPaid);
    };
    box.appendChild(f);
  }

  function showReset(user, needOrder) {
    var box = $("gateView");
    if (!box) return;
    $("gateTitle").textContent = "重设密码 · " + user;
    box.innerHTML = "";
    var f = el("form");
    f.appendChild(el("p", "mut", needOrder
      ? "该账号已开通会员。为确认是本人操作，请输入任一笔本产品的支付订单号（o_ 开头的一串字符）核验；核验只做查询，不会重复发放或扣减天数。"
      : "该账号就在本机，直接设置新密码即可。剩余试用天数与会员权益不受影响。"));
    var oi = null;
    if (needOrder) {
      f.appendChild(el("label", null, "支付订单号"));
      oi = el("input"); oi.type = "text"; oi.placeholder = "o_ 开头的订单号"; f.appendChild(oi);
    }
    f.appendChild(el("label", null, "新密码"));
    var p1 = el("input"); p1.type = "password"; p1.placeholder = "至少 6 位"; f.appendChild(p1);
    f.appendChild(el("label", null, "确认新密码"));
    var p2 = el("input"); p2.type = "password"; f.appendChild(p2);
    var row = el("div", "row");
    var b = el("button", "act", needOrder ? "核验并重设" : "重设密码");
    b.type = "button";
    row.appendChild(b);
    var back = el("button", "ghost", "返回登录");
    back.type = "button";
    row.appendChild(back);
    f.appendChild(row);
    var tip = el("p", "mut"); tip.style.fontSize = "12px";
    f.appendChild(tip);
    back.onclick = function () { _viewKey = ""; showLogin(); };

    function done() {
      // 订单号交给服务端核验（只读、不重复发放权益），不再信任前端 /status 结果
      var oid = needOrder ? String(oi.value || "").trim() : "";
      b.disabled = true;
      tip.textContent = "正在重设密码…";
      resetPassword(user, p1.value, oid).then(function (okFlag) {
        b.disabled = false;
        if (okFlag) { toast("密码已重设，已自动登录"); _viewKey = ""; renderGate(); }
        else tip.textContent = "重设未成功，请查看提示后重试；长期失败请联系客服。";
      });
    }
    b.onclick = function () {
      if (String(p1.value || "").length < 6) { toast("新密码至少 6 位"); return; }
      if (p1.value !== p2.value) { toast("两次密码不一致"); return; }
      if (needOrder && !String(oi.value || "").trim()) { toast("请输入支付订单号"); return; }
      done();
    };
    box.appendChild(f);
  }

  function buildUpgrade(a) {
    var wrap = el("div");
    var tip = a.isPaid ? "您的会员已到期，续费后可继续使用全部功能（时长自动叠加）。" : "您的 7 天试用已结束，开通会员后可继续正常使用全部功能。";
    wrap.appendChild(el("p", "mut", tip));

    var plans = el("div", "plans");
    for (var i = 0; i < PLANS.length; i++) {
      var pl = el("label", "plan");
      var r = el("input");
      r.type = "radio"; r.name = "qk_plan"; r.value = PLANS[i].id;
      if (i === PLANS.length - 1) r.checked = true;
      pl.appendChild(r);
      pl.appendChild(el("b", null, PLANS[i].name));
      pl.appendChild(document.createTextNode(" " + PLANS[i].price));
      plans.appendChild(pl);
    }
    wrap.appendChild(plans);

    var agreeRow = el("label");
    agreeRow.style.cssText = "margin-top:8px;display:block";
    var agree = el("input"); agree.type = "checkbox"; agree.id = "agreePay";
    agreeRow.appendChild(agree);
    agreeRow.appendChild(document.createTextNode(" 我已阅读并同意"));
    var link = el("a", null, "《会员服务协议》");
    link.href = "#";
    link.onclick = function (e) {
      e.preventDefault();
      alert("会员服务协议：会员期内可使用全科提分全部功能；账号、错题与飞轮数据保存在本站服务端数据库，换设备登录后自动同步，可随时导出；虚拟商品一经开通不支持退款。");
    };
    agreeRow.appendChild(link);
    wrap.appendChild(agreeRow);

    var row = el("div", "row");
    var bQR = el("button", "act", "生成支付二维码");
    bQR.type = "button"; bQR.id = "btnGenQR";
    row.appendChild(bQR);
    wrap.appendChild(row);

    var qr = el("div"); qr.id = "payQR"; wrap.appendChild(qr);

    var paidRow = el("div", "row"); paidRow.id = "paidRow"; paidRow.style.display = "none";
    var bRe = el("button", "ghost", "重新生成二维码");
    bRe.type = "button"; bRe.id = "btnRegen";
    paidRow.appendChild(bRe);
    wrap.appendChild(paidRow);

    var payTip = el("p", "mut"); payTip.id = "payTip";
    wrap.appendChild(payTip);

    var claimRow = el("div", "row");
    claimRow.style.marginTop = "10px";
    var ci = el("input"); ci.id = "claimId"; ci.placeholder = "已付过款？输入订单号激活";
    ci.style.flex = "1"; ci.style.minWidth = "0";
    claimRow.appendChild(ci);
    var bClaim = el("button", "act", "激活");
    bClaim.type = "button"; bClaim.id = "btnClaim";
    claimRow.appendChild(bClaim);
    wrap.appendChild(claimRow);
    var claimTip = el("p", "mut"); claimTip.id = "claimTip"; claimTip.style.fontSize = "12px";
    wrap.appendChild(claimTip);

    bQR.onclick = function () {
      var pid = checkedPlan();
      createOrder(pid);
    };
    bRe.onclick = function () {
      var pid = checkedPlan();
      resetReqId(pid);
      createOrder(pid);
    };
    bClaim.onclick = function () {
      var oid = String(ci.value || "").trim();
      if (!oid) { toast("请输入订单号"); return; }
      claimByOrder(oid, claimTip);
    };
    return wrap;
  }

  function checkedPlan() {
    var r = document.querySelector ? document.querySelector('input[name="qk_plan"]:checked') : null;
    return r ? r.value : "m";
  }

  /* ------------------------- 支付 ------------------------- */
  var _payTimer = null, _payOrderId = null, _payPlanId = null, _payTries = 0;
  function stopPayPoll() {
    if (_payTimer) { clearInterval(_payTimer); _payTimer = null; }
    _payTries = 0;
  }
  function reqIdFor(pid) {
    var key = "qk_req_" + pid;
    var v = "";
    try { v = sessionStorage.getItem(key) || ""; } catch (e) { }
    var parts = v.split(":");
    if (parts.length === 2 && Number(parts[1]) && now() - Number(parts[1]) < 5 * 60 * 1000) return parts[0];
    var id = "r" + Math.random().toString(36).slice(2, 10) + now().toString(36);
    try { sessionStorage.setItem(key, id + ":" + now()); } catch (e) { }
    return id;
  }
  function resetReqId(pid) {
    try { sessionStorage.removeItem("qk_req_" + pid); } catch (e) { }
  }

  function createOrder(pid) {
    var agree = $("agreePay");
    if (!agree || !agree.checked) { toast("请先勾选《会员服务协议》"); return; }
    var tip = $("payTip");
    if (tip) tip.textContent = "正在生成微信支付二维码…";
    var plan = null;
    for (var i = 0; i < PLANS.length; i++) if (PLANS[i].id === pid) plan = PLANS[i];
    if (!plan) { toast("请先选择套餐"); return; }

    fetch(PAY_API_BASE + "create", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ plan: pid, client: deviceId(), reqId: reqIdFor(pid) })
    }).then(function (r) {
      return r.json().then(function (j) { return { ok: r.ok, j: j }; });
    }).then(function (o) {
      if (!o.ok || !o.j || !o.j.orderId) {
        if (tip) tip.textContent = "创建订单失败：" + ((o.j && o.j.error) || "请稍后重试");
        return;
      }
      _payOrderId = o.j.orderId;
      _payPlanId = pid;
      renderPayQR(o.j.codeUrl);
      $("paidRow").style.display = "flex";
      if (tip) tip.textContent = "请使用微信「扫一扫」支付 " + plan.price + "（" + plan.name + "）。支付成功后本窗口将自动解锁。";
      startPayPoll(o.j.orderId, pid);
    }).catch(function () {
      if (tip) tip.textContent = "网络异常，无法连接支付服务，请稍后重试。";
    });
  }

  function startPayPoll(orderId, pid) {
    stopPayPoll();
    _payTries = 0;
    _payTimer = setInterval(function () {
      _payTries++;
      if (_payTries > PAY_POLL_MAX) {
        stopPayPoll();
        var t = $("payTip");
        if (t) t.textContent = "订单查询已停止。若您已完成支付，请点「重新生成二维码」旁的「输入订单号激活」，或刷新页面。";
        return;
      }
      fetch(PAY_API_BASE + "status?id=" + encodeURIComponent(orderId), { cache: "no-store" })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d) return;
          if (d.paid === true) {
            stopPayPoll();
            markPaid(d.plan, d.days);
            return;
          }
          if (d.orderPaid === true && d.granted === false) {
            stopPayPoll();
            var t = $("payTip");
            if (t) t.textContent = "该订单未通过权益核验（" + (d.reason || "订单异常") + "），请联系客服。";
            return;
          }
          if (d.expiresAt) {
            var left = Math.floor((new Date(d.expiresAt).getTime() - now()) / 1000);
            if (left <= 0) {
              stopPayPoll();
              var t2 = $("payTip");
              if (t2) t2.textContent = "二维码已过期，请点「重新生成二维码」。";
            }
          }
        }).catch(function () { });
    }, PAY_POLL_MS);
  }

  // 权益一律以服务端给的 plan/days 为准
  function markPaid(pid, daysOverride) {
    var a = loadAuth();
    if (!a) { toast("请先注册/登录"); renderGate(); return; }
    var days = Number(daysOverride) > 0 ? Number(daysOverride) : 30;
    var base = (paidEnd(a) > now()) ? paidEnd(a) : now(); // 续费叠加
    a.isPaid = true;
    a.plan = pid || a.plan || "m";
    a.paidTs = now();
    a.paidUntil = base + days * 864e5;
    saveAuth(a);
    // 同步回账号档案，退出重登不丢会员
    var users = loadUsers();
    if (a.phone && Object.prototype.hasOwnProperty.call(users, a.phone)) {
      users[a.phone].isPaid = true;
      users[a.phone].plan = a.plan;
      users[a.phone].paidTs = a.paidTs;
      users[a.phone].paidUntil = a.paidUntil;
      saveUsers(users);
    }
    toast("会员已开通，有效期至 " + fmtDate(a.paidUntil));
    stopPayPoll();
    renderGate();
  }

  function claimByOrder(oid, tipEl, adminCode) {
    if (tipEl) tipEl.textContent = "正在核验订单…";
    var payload = { orderId: oid, client: deviceId() };
    if (adminCode) payload.adminCode = adminCode;
    fetch(PAY_API_BASE + "claim", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    }).then(function (r) {
      return r.json().then(function (j) { return { ok: r.ok, status: r.status, j: j }; });
    }).then(function (o) {
      if (o.ok && o.j && o.j.paid) {
        markPaid(o.j.plan, o.j.days);
        if (tipEl) tipEl.textContent = "已激活：" + (o.j.planName || "会员") + "（" + o.j.days + " 天）";
        toast("会员已激活");
        return;
      }
      var msg = (o.j && o.j.error) || "请核对订单号";
      // 换机/客服场景：提示输入补单码
      if (o.status === 403 && msg.indexOf("绑定") >= 0 && !adminCode) {
        var code = window.prompt("该订单绑定在其他设备上。\n如为换机恢复，请输入客服提供的补单码：", "");
        if (code) { claimByOrder(oid, tipEl, String(code).trim()); return; }
      }
      if (tipEl) tipEl.textContent = "激活失败：" + msg;
      else toast("激活失败：" + msg);
    }).catch(function () {
      if (tipEl) tipEl.textContent = "网络异常，请稍后重试";
      else toast("网络异常，请稍后重试");
    });
  }

  function renderPayQR(text) {
    var box = $("payQR");
    if (!box) return;
    box.innerHTML = "";
    if (!text) { box.appendChild(el("p", "mut", "支付链接获取失败，请重试。")); return; }
    try {
      var qr = window.qrcode(0, "M");
      qr.addData(text);
      qr.make();
      var cell = 4, n = qr.getModuleCount(), size = cell * n;
      var c = document.createElement("canvas");
      c.width = size; c.height = size;
      var ctx = c.getContext("2d");
      ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, size, size); ctx.fillStyle = "#000";
      for (var r = 0; r < n; r++) for (var cc = 0; cc < n; cc++) if (qr.isDark(r, cc)) ctx.fillRect(cc * cell, r * cell, cell, cell);
      box.appendChild(c);
      var cap = el("div", "mut", "扫描上方二维码完成支付");
      cap.style.textAlign = "center";
      cap.style.marginTop = "4px";
      box.appendChild(cap);
    } catch (e) {
      box.appendChild(el("p", "mut", "二维码生成失败，请复制链接手动支付：" + text));
    }
  }

  /* ------------------------- 账户栏 ------------------------- */
  function buildAcctBar() {
    if ($("acctBar")) { updateAcctBar(); return; }
    var bar = el("div");
    bar.id = "acctBar";
    var wrap = document.querySelector(".wrap") || document.body;
    wrap.insertBefore(bar, wrap.firstChild);
    updateAcctBar();
  }
  function updateAcctBar() {
    var bar = $("acctBar");
    if (!bar) return;
    var a = loadAuth();
    bar.innerHTML = "";
    if (!a) {
      bar.appendChild(el("span", null, "未登录 "));
      var l = el("a", null, "登录 / 注册");
      l.href = "#";
      l.onclick = function (e) { e.preventDefault(); _viewKey = ""; showLogin(); };
      bar.appendChild(l);
      return;
    }
    var info;
    if (a.isPaid) {
      var end = paidEnd(a);
      info = end > now() ? ("会员（" + planName(a.plan) + "）至 " + fmtDate(end)) : ("会员已到期（" + planName(a.plan) + "）");
    } else {
      var tl = trialLeft(a);
      info = tl > 0 ? ("试用剩余 " + tl + " 天") : "试用已结束";
    }
    var span = el("span", null, "👤 " + safeText(a.phone || "游客") + " ｜ " + info); // textContent，用户输入不解析 HTML
    bar.appendChild(span);
    bar.appendChild(document.createTextNode(" "));
    var c = el("a", null, "激活订单");
    c.href = "#";
    c.onclick = function (e) { e.preventDefault(); claimPrompt(); };
    bar.appendChild(c);
    bar.appendChild(document.createTextNode(" "));
    var lo = el("a", null, "退出");
    lo.href = "#";
    lo.onclick = function (e) {
      e.preventDefault();
      stopPayPoll();
      try { localStorage.removeItem(AUTH_KEY); } catch (err) { }
      try { QKCloud.authLogout(); } catch (err2) { }
      _viewKey = "";
      toast("已退出，云端数据已保留");
      renderGate();
    };
    bar.appendChild(lo);
  }

  function claimPrompt() {
    var a = loadAuth();
    if (!a) { toast("请先注册/登录"); _viewKey = ""; renderGate(); return; }
    var oid = window.prompt("请输入支付订单号（o_ 开头的一串字符，可在微信账单/客服处获取）：", "");
    if (!oid) return;
    oid = String(oid).trim();
    if (!oid) return;
    toast("正在核验订单…");
    claimByOrder(oid, null);
  }
  function logout() {
    stopPayPoll();
    try { localStorage.removeItem(AUTH_KEY); } catch (e) { }
    try { QKCloud.authLogout(); } catch (e2) { }
    _viewKey = "";
    renderGate();
  }

  /* ------------------------- 数据飞轮（可选模块调用） ------------------------- */
  function logFlywheel(raw, corrected) {
    var a = loadAuth();
    var arr = loadFly();
    arr.push({
      ts: now(),
      user: a ? a.phone : "guest",
      subj: typeof curSubj !== "undefined" ? curSubj : "",
      ver: typeof curVer !== "undefined" ? curVer : "",
      grade: typeof GSEL !== "undefined" ? GSEL : "",
      raw: String(raw || "").slice(0, 2000),
      corrected: String(corrected || "").slice(0, 2000),
      engine: typeof _tessLocal !== "undefined" && _tessLocal ? "local" : "cdn"
    });
    if (arr.length > 5000) arr = arr.slice(-5000);
    saveFly(arr);
    updateFlyCount();
  }
  function updateFlyCount() {
    var c = $("flyCount");
    if (c) c.textContent = String(loadFly().length);
  }
  function flyReport() {
    var rawEl = $("ocrText"), corrEl = $("mText");
    var raw = rawEl ? rawEl.value : "";
    var corr = corrEl ? corrEl.value : "";
    if (!raw) { toast("还没有识别结果"); return; }
    logFlywheel(raw, corr);
    toast("已上报纠错数据到飞轮");
  }

  window.QK = {
    version: "2.0.0",
    AUTH_KEY: AUTH_KEY, FLY_KEY: FLY_KEY,
    PAY_API_BASE: PAY_API_BASE,
    deviceId: deviceId,
    loadAuth: loadAuth, saveAuth: saveAuth,
    loadUsers: loadUsers, saveUsers: saveUsers,
    loadFly: loadFly, saveFly: saveFly,
    hasAccess: hasAccess, paidEnd: paidEnd, trialEnd: trialEnd, trialLeft: trialLeft,
    planName: planName, fmtDate: fmtDate, toast: toast, el: el, $: $,
    register: register, login: login, markPaid: markPaid,
    resetPassword: resetPassword, showForgot: showForgot, showReset: showReset,
    renderGate: function () { _viewKey = ""; renderGate(); },
    showLogin: showLogin, logout: logout, claimPrompt: claimPrompt,
    claimByOrder: claimByOrder, createOrder: createOrder, startPayPoll: startPayPoll, stopPayPoll: stopPayPoll,
    logFlywheel: logFlywheel, updateFlyCount: updateFlyCount, flyReport: flyReport
  };

  function boot() {
    migrate();
    if (!STORE_OK) {
      try {
        var bar = el("div");
        bar.style.cssText = "background:#b3261e;color:#fff;padding:10px 14px;font-size:14px;border-radius:8px;margin:0 0 10px;line-height:1.6";
        bar.textContent = "⚠ 存储不可用：" + STORE_HINT;
        var wrap = document.querySelector(".wrap") || document.body;
        wrap.insertBefore(bar, wrap.firstChild);
      } catch (e) { }
    }
    buildAcctBar();
    renderGate();
    // 阶段 B：拉取云端账号 / 权益 / 错题库 / 飞轮，完成后覆盖本地缓存并重绘
    QKCloud.bootstrap();
    // 页面重新可见时补一次校验（手机上从后台切回来）
    if (document.addEventListener) {
      document.addEventListener("visibilitychange", function () {
        if (!document.hidden) renderGate();
      });
    }
  }
  if (document.body) boot();
  else if (document.addEventListener) document.addEventListener("DOMContentLoaded", boot);
})();


// ===================== 数据飞轮(B2B2C) · 依赖 window.QK =====================
(function(){
  "use strict";
  var QK=(typeof window!=="undefined")?window.QK:null; if(!QK) return;
  var $=QK.$, toast=QK.toast;
  function logFlywheel(raw,corrected){ QK.logFlywheel(raw,corrected); }
  function flyReport(){ var r=$("ocrText"), c=$("mText"); var raw=r?r.value:""; var corr=c?c.value:""; if(!raw){toast("还没有识别结果");return;} logFlywheel(raw,corr); toast("已上报纠错数据到飞轮"); }
  function renderFlyList(){
    var box=$("flyList"); if(!box)return; var arr=QK.loadFly().slice(-20).reverse();
    if(!arr.length){box.textContent="暂无数据，拍照 OCR 后点「上报纠错」即可采集。";return;}
    box.innerHTML="";
    arr.forEach(function(x){
      var meta=(x.subj||"")+(x.ver?"/"+x.ver:"")+(x.grade&&x.grade!=="全部"?"/"+x.grade:"");
      var d=document.createElement("div");
      d.style.cssText="margin:4px 0;border-bottom:1px dashed #e2e8f0;padding-bottom:4px";
      d.appendChild(document.createTextNode("· "+new Date(x.ts).toLocaleString()+" ｜ "+meta+" ｜ 引擎:"+x.engine));
      d.appendChild(document.createElement("br"));
      d.appendChild(document.createTextNode("  OCR: "+(x.raw||"").slice(0,60)));
      if(x.corrected){ d.appendChild(document.createElement("br")); d.appendChild(document.createTextNode("  订正: "+x.corrected.slice(0,60))); }
      box.appendChild(d);
    });
  }
  function flyExportJSON(){ download("quanke_flywheel.json", JSON.stringify(QK.loadFly(),null,2), "application/json"); }
  function flyExportCSV(){
    var arr=QK.loadFly(); if(!arr.length){toast("暂无数据");return;}
    var head=["ts","user","subj","ver","grade","engine","raw","corrected"];
    var rows=arr.map(function(x){return head.map(function(k){return csvCell(x[k]==null?"":x[k]);}).join(",");});
    download("quanke_flywheel.csv", "\ufeff"+head.join(",")+"\n"+rows.join("\n"), "text/csv");
  }
  function csvCell(v){v=String(v).replace(/"/g,'""');return /[",\n]/.test(v)?'"'+v+'"':v;}
  function flySync(){
    var ep=$("flyEndpoint"); ep=ep?ep.value.trim():""; if(!ep){toast("请先填写 B 端回传地址");return;}
    var arr=QK.loadFly(); if(!arr.length){toast("暂无数据可同步");return;}
    try{
      var xhr=new XMLHttpRequest(); xhr.open("POST",ep,true); xhr.setRequestHeader("Content-Type","application/json");
      xhr.onreadystatechange=function(){ if(xhr.readyState===4){ toast(xhr.status>=200&&xhr.status<300?"已同步 "+arr.length+" 条到 B 端":"同步失败("+xhr.status+")，请检查地址"); } };
      xhr.send(JSON.stringify({app:"quanke9",records:arr}));
    }catch(e){ toast("同步出错："+e.message); }
  }
  function download(name,content,type){
    try{ var blob=new Blob([content],{type:type}); var url=URL.createObjectURL(blob); var a=document.createElement("a"); a.href=url; a.download=name; document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(function(){URL.revokeObjectURL(url);},1000); }
    catch(e){ toast("导出失败："+e.message); }
  }
  function renderFlywheel(){
    var tabs=$("tabs"); if(!tabs||$("flyTabBtn"))return;
    var b=document.createElement("button"); b.textContent="📡 数据飞轮"; b.dataset.t="数据飞轮"; b.id="flyTabBtn"; tabs.appendChild(b);
    var panel=document.createElement("div"); panel.className="card"; panel.id="数据飞轮";
    panel.innerHTML='<h2>📡 数据飞轮（B2B2C 试点）</h2>'+
      '<p class="mut">每次拍照 OCR 识别后点「📡 上报纠错」，即把 OCR 文本与你的订正文本记录下来，用于迭代识别模型。学校(B端)可配置回传地址，将多名学生数据汇总回传，形成「识别→纠错→模型优化」飞轮。</p>'+
      '<div>已采集：<b id="flyCount">0</b> 条 ｜ 最近上报：<span id="flyLast">-</span></div>'+
      '<div class="row"><button class="ghost" onclick="flyExportJSON()">导出 JSON</button><button class="ghost" onclick="flyExportCSV()">导出 CSV</button><button class="ghost" onclick="flySync()">同步到 B 端</button></div>'+
      '<div class="row"><input id="flyEndpoint" style="flex:1" placeholder="B 端回传地址（可选，如 https://school.example.com/flywheel）"></div>'+
      '<div id="flyList" style="max-height:160px;overflow:auto;font-size:12px;margin-top:8px;"></div>';
    var host=document.getElementById("作业批改"); if(host&&host.parentNode) host.parentNode.appendChild(panel);
    QK.updateFlyCount(); renderFlyList();
  }
  if(typeof window==="undefined") return;
  window.flyExportJSON=flyExportJSON; window.flyExportCSV=flyExportCSV; window.flySync=flySync; window.flyReport=flyReport;
  function initFly(){ renderFlywheel(); QK.updateFlyCount(); renderFlyList(); }
  if(document.body) initFly(); else document.addEventListener("DOMContentLoaded", initFly);
  window.QKFLY={logFlywheel:logFlywheel,flyReport:flyReport,renderFlyList:renderFlyList};
})();

/*QUANKE_GATE_JS_END*/
</script>
</body>
</html>
