# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# 运行时数据（含默认种子，生产请按需备份）
/data

# workbuddy 本地数据（含项目笔记与本地配置，不入库）
.workbuddy/

# CloudBase 部署工具会自动改写此文件并写入真实环境 ID，不入库
cloudbaserc.json

# 商户私钥/平台证书等凭据文件目录：目录本身入库（保证 Docker 构建可 COPY），
# 但目录内所有密钥文件一律禁止入库。
credentials/*.pem
credentials/*.p12
credentials/*.key
credentials/*.crt
*.p12

# 测试覆盖率报告（vitest --coverage 生成物，属构建产物不入库）
coverage/
coverage
# 本地测试/构建临时产物
*.tsbuildinfo
build.log
audit-after.json
semgrep-local.json
sast.txt

# 待写入部署平台的密钥暂存文件（含真实随机密钥，绝不入库）
.secrets.pending.json
*.secrets.pending.json

# 本地 vitest 临时目录（TMPDIR 重定向用，避免沙箱临时目录 EPERM）
.tmp-vitest/
